---
import Layout from '../../layouts/Layout.astro';
import { Navigation } from '../../app/components/Navigation';
import { GiscusComments } from '../../app/components/GiscusComments';
import { renderTipTap, readingTime, formatDate, getExcerpt } from '../../lib/tiptap-renderer';

const { id } = Astro.params;
const BLOG_HUB_SLUG = import.meta.env.BLOG_HUB_SLUG ?? '';
const SITE_URL  = 'https://info.citinet.cloud';
// See blog/index.astro — read from the hub's own outbound push, not fetched
// from the hub directly.
const BLOG_POSTS_URL = 'https://raw.githubusercontent.com/fergtech/citinet-registry/main/blog-posts.json';

interface Note {
  id: string;
  title: string;
  author: string;
  web_body_rich: unknown;
  web_body_plain: string;
  color: string | null;
  created_at: string;
  updated_at: string;
}

let note: Note | null = null;
let htmlContent = '';

if (BLOG_HUB_SLUG && id) {
  try {
    const res = await fetch(BLOG_POSTS_URL, { signal: AbortSignal.timeout(5000) });
    if (res.ok) {
      const data = await res.json();
      const notes: Note[] = data[BLOG_HUB_SLUG]?.notes ?? [];
      note = notes.find(n => n.id === id) ?? null;
      if (!note) return Astro.redirect('/blog');
      htmlContent = renderTipTap(note.web_body_rich);
    }
  } catch { /* note stays null — "not found or unavailable" state below */ }
}

// Cache individual posts for 5 minutes: content changes infrequently.
Astro.response.headers.set('Cache-Control', 's-maxage=300, stale-while-revalidate=600');

const pageTitle   = note ? `${note.title} | Citinet Blog` : 'Citinet Blog';
const description = note ? getExcerpt(note.web_body_plain, 160) : undefined;
const canonicalUrl = `${SITE_URL}/blog/${id}`;
---

<Layout
  title={pageTitle}
  description={description}
  ogType="article"
  ogUrl={canonicalUrl}
  canonical={canonicalUrl}
  articlePublishedTime={note?.created_at}
  articleAuthor={note?.author}
>
  <div class="min-h-screen bg-slate-950 text-white">
    <Navigation client:load />

    <div class="max-w-2xl mx-auto px-6 pt-32 pb-24">

      <a href="/blog" class="inline-flex items-center gap-1.5 text-sm text-slate-500 hover:text-violet-400 transition-colors mb-12">
        ← All posts
      </a>

      {!note && (
        <p class="text-slate-500 text-center py-20">Post not found or unavailable.</p>
      )}

      {note && (
        <article>
          <!-- Accent bar -->
          <div
            class="h-1 rounded-full w-16 mb-8"
            style={note.color ? `background:${note.color}` : 'background: linear-gradient(to right, #2563eb, #7c3aed)'}
          />

          <h1 class="text-3xl md:text-4xl font-bold text-white mb-6 leading-tight">
            {note.title || 'Untitled'}
          </h1>

          <div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-sm text-slate-500 mb-12 pb-8 border-b border-white/10">
            <span class="font-medium text-slate-400">{note.author}</span>
            <span>·</span>
            <span>{formatDate(note.updated_at)}</span>
            <span>·</span>
            <span>{readingTime(note.web_body_plain)}</span>
          </div>

          <div class="blog-prose" set:html={htmlContent} />

          <GiscusComments client:only="react" />
        </article>
      )}
    </div>

    <div class="border-t border-white/5 py-8 text-center text-slate-600 text-sm">
      <a href="/blog" class="hover:text-violet-400 transition-colors">← Back to blog</a>
    </div>
  </div>
</Layout>
