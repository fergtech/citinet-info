---
import Layout from '../../layouts/Layout.astro';
import { Navigation } from '../../app/components/Navigation';
import { getExcerpt, readingTime, formatDate } from '../../lib/tiptap-renderer';

const BLOG_HUB_SLUG = import.meta.env.BLOG_HUB_SLUG ?? '';
const SITE_URL = 'https://info.citinet.cloud';
// Published via the hub's own outbound push (api/blog-sync.js on citinet-web),
// not fetched from the hub directly — Vercel's serverless network can't
// reliably reach into a residential/tailnet-hosted hub inbound. See
// api/blogSyncHeartbeat.js in the citinet-web repo for the push side.
const BLOG_POSTS_URL = 'https://raw.githubusercontent.com/fergtech/citinet-registry/main/blog-posts.json';

interface Note {
  id: string;
  title: string;
  web_body_plain: string;
  author: string;
  created_at: string;
  updated_at: string;
  color: string | null;
}

let notes: Note[] = [];
let fetchError = false;

if (BLOG_HUB_SLUG) {
  try {
    const res = await fetch(BLOG_POSTS_URL, { signal: AbortSignal.timeout(5000) });
    if (res.ok) {
      const data = await res.json();
      notes = data[BLOG_HUB_SLUG]?.notes ?? [];
    } else {
      fetchError = true;
    }
  } catch {
    fetchError = true;
  }
}

// Only cache when we have real posts. Never cache empty or error states, so a
// newly-published post appears quickly and stale "No posts yet" isn't stuck in CDN.
if (notes.length > 0) {
  Astro.response.headers.set('Cache-Control', 's-maxage=60, stale-while-revalidate=300');
}
---

<Layout
  title="Blog | Citinet"
  description="Updates, ideas, and stories from the people building Citinet."
  ogUrl={`${SITE_URL}/blog`}
  canonical={`${SITE_URL}/blog`}
>
  <div class="min-h-screen bg-background text-foreground">
    <Navigation client:load />

    <div class="max-w-[1248px] mx-auto px-6 pt-32 pb-20">

      <!-- Header -->
      <div class="mb-12">
        <p class="font-mono text-xs uppercase tracking-wider text-muted-foreground mb-4">The Citinet Blog</p>
        <h1 class="text-3xl md:text-4xl font-semibold tracking-tight text-foreground mb-3 leading-tight">
          From the <span class="text-muted-foreground">community</span>
        </h1>
        <p class="text-lg text-muted-foreground mb-3">Updates, ideas, and stories from the people building Citinet.</p>
        <p class="font-mono text-xs text-muted-foreground">
          Powered by a{' '}
          <a href="https://citinet.cloud" class="text-foreground underline underline-offset-2 hover:text-muted-foreground transition-colors">Citinet hub</a>
        </p>
      </div>

      <!-- States -->
      {!BLOG_HUB_SLUG && (
        <p class="text-muted-foreground text-center py-20">BLOG_HUB_SLUG environment variable not set.</p>
      )}
      {BLOG_HUB_SLUG && fetchError && (
        <p class="text-muted-foreground text-center py-20">Could not load posts. Check back soon.</p>
      )}
      {BLOG_HUB_SLUG && !fetchError && notes.length === 0 && (
        <p class="text-muted-foreground text-center py-20">No posts yet.</p>
      )}

      <!-- Post grid -->
      {notes.length > 0 && (
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {notes.map((note) => (
            <a
              href={`/blog/${note.id}`}
              class="group block bg-card border border-border rounded-lg overflow-hidden hover:bg-muted/60 transition-colors"
            >
              <div class="h-0.5" style={note.color ? `background:${note.color}` : 'background: var(--border)'} />
              <div class="p-6">
                <h2 class="text-base font-semibold text-foreground mb-2 leading-snug line-clamp-2">
                  {note.title || 'Untitled'}
                </h2>
                <p class="text-muted-foreground text-sm leading-relaxed mb-5 line-clamp-3">
                  {getExcerpt(note.web_body_plain, 160)}
                </p>
                <div class="flex items-center justify-between font-mono text-xs text-muted-foreground">
                  <span>{note.author}</span>
                  <div class="flex items-center gap-3">
                    <span>{readingTime(note.web_body_plain)}</span>
                    <span>{formatDate(note.updated_at)}</span>
                  </div>
                </div>
              </div>
            </a>
          ))}
        </div>
      )}
    </div>

    <div class="border-t border-border py-8 text-center font-mono text-muted-foreground text-xs">
      <a href="https://info.citinet.cloud" class="hover:text-foreground transition-colors">info.citinet.cloud</a>
      {' · '}
      <a href="https://citinet.cloud" class="hover:text-foreground transition-colors">citinet.cloud</a>
    </div>
  </div>
</Layout>
