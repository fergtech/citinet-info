---
import '../styles/index.css';

interface Props {
  title?: string;
  description?: string;
  ogType?: 'website' | 'article';
  ogUrl?: string;
  ogImage?: string;
  canonical?: string;
  articlePublishedTime?: string;
  articleAuthor?: string;
}

const {
  title = 'Citinet - A Home for Your Community Online',
  description,
  ogType = 'website',
  ogUrl,
  ogImage,
  canonical,
  articlePublishedTime,
  articleAuthor,
} = Astro.props;

const SITE_URL    = 'https://info.citinet.cloud';
const LOGO        = `${SITE_URL}/imgs/logo/logo.png`;
const DEFAULT_DESC = 'Announcements, files, messaging, polls and a shared map for HOAs, co-ops, tenant unions and neighborhood groups. One organizer runs the hub; members just open a browser. Open source and self-hosted.';

const metaDesc    = description || DEFAULT_DESC;
const metaImage   = ogImage || LOGO;
const metaUrl     = ogUrl || SITE_URL;
const canonicalUrl = canonical || metaUrl;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('theme');
          var dark = t ? t === 'dark' : window.matchMedia('(prefers-color-scheme: dark)').matches;
          document.documentElement.classList.toggle('dark', dark);
        } catch (e) {}
      })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    <title>{title}</title>
    <meta name="description" content={metaDesc} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&family=Source+Serif+4:opsz,wght@8..60,400;8..60,600&display=swap" rel="stylesheet" />

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/imgs/logo/logo.png" />
    <link rel="apple-touch-icon" href="/imgs/logo/logo.png" />

    <!-- Open Graph -->
    <meta property="og:type"        content={ogType} />
    <meta property="og:site_name"   content="Citinet" />
    <meta property="og:title"       content={title} />
    <meta property="og:description" content={metaDesc} />
    <meta property="og:image"       content={metaImage} />
    <meta property="og:image:alt"   content={title} />
    <meta property="og:url"         content={metaUrl} />
    <meta property="og:locale"      content="en_US" />
    {articlePublishedTime && <meta property="article:published_time" content={articlePublishedTime} />}
    {articleAuthor        && <meta property="article:author"         content={articleAuthor} />}

    <!-- Twitter / X Card -->
    <meta name="twitter:card"        content="summary_large_image" />
    <meta name="twitter:title"       content={title} />
    <meta name="twitter:description" content={metaDesc} />
    <meta name="twitter:image"       content={metaImage} />
    <meta name="twitter:image:alt"   content={title} />
  </head>
  <body>
    <slot />
  </body>
</html>
